# ---------------------------------------------------------------------------
# Lycée Academics — local environment settings
# Copy this file to .env and fill in the values. Never commit the real .env
# (it is listed in .gitignore).
# The app loads it from backend-app/config.py.
# ---------------------------------------------------------------------------

# Flask session/signing key. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database. Leave blank to use the local SQLite file (instance/lyceedemuhura.db).
# For PostgreSQL use a URI such as:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Maximum upload size in bytes (default 100 MB).
MAX_CONTENT_LENGTH=104857600

# Public address of this app, e.g. http://192.168.1.233:5000 on the school
# network. Used by the RFID helper page and hardware/serial_bridge.py.
PUBLIC_BASE_URL=

# Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# RFID reader (ESP32) — /student/rfid-login and /student/rfid-status
# ---------------------------------------------------------------------------
# Required: the status endpoint answers 503 until this is set. Put the same
# value in hardware/esp32_school_rfid/rfid_config.h (RFID_DEVICE_TOKEN).
RFID_DEVICE_TOKEN=
# Optional: leave blank to accept cards from every class and show school-wide
# totals. Set it only to restrict this reader to one exact class.
RFID_DEVICE_CLASS=
# Optional: full status URL shown on /student/rfid-login for checking the
# reader config, e.g. http://192.168.1.233:5000/student/rfid-status
RFID_STATUS_URL=

# ---------------------------------------------------------------------------
# Optional integrations — leave blank/false to disable
# ---------------------------------------------------------------------------
# Room occupancy limits for meetings, keyed by the exact room name.
ROOM_CAPACITY_LIMITS={"Boardroom":12,"Lab 1":20}

# Microsoft Graph calendar / Teams meetings.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_CALENDAR_MAILBOX=
MS_GRAPH_TIME_ZONE=South Africa Standard Time
MS_GRAPH_CREATE_TEAMS_MEETINGS=false

# Parent email alerts (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
NOTIFICATION_TIMEOUT=10

# Parent SMS alerts (Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
